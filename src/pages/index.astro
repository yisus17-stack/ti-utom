---
import { Image } from 'astro:assets';
import logoUtom from '../assets/logo-utom-blanco.png';
import studentHero from '../assets/estudiante-hero.png';
import studentCta from '../assets/estudiante-utom.png';
import htmlLogo from '../assets/html5.svg';
import javascriptLogo from '../assets/javascript.svg';
import tailwindLogo from '../assets/tailwindcss.svg';
import pythonLogo from '../assets/python.svg';
import javaLogo from '../assets/java.svg';
import postgresqlLogo from '../assets/postgresql.svg';
import mysqlLogo from '../assets/mysql-icon-dark.svg';
import numpyLogo from '../assets/numpy-seeklogo.svg';
import pandasLogo from '../assets/pandas-icon-seeklogo.svg';
import gitLogo from '../assets/git.svg';
import githubLogo from '../assets/github_dark.svg';
import ciscoLogo from '../assets/cisco_dark.svg';
import arduinoLogo from '../assets/arduino-seeklogo.svg';
import raspberryPiLogo from '../assets/raspberry_pi.svg';
import '../styles/global.css';
import '../styles/poster.css';
import '../styles/mascot.css';
import '../styles/navbar.css';
import '../styles/utom-palette.css';
import '../styles/ribbons.css';
import '../styles/typography.css';
import '../styles/reference-hero.css';
import '../styles/hero-fix.css';

const semesters = [
  { n: '01', title: 'Descubre', stage: 'base', subjects: ['Fundamentos de programación', 'Matemáticas', 'Redes', 'Habilidades digitales'] },
  { n: '02', title: 'Construye', stage: 'base', subjects: ['Programación estructurada', 'Cálculo diferencial', 'Sistemas operativos', 'Enrutamiento'] },
  { n: '03', title: 'Resuelve', stage: 'build', subjects: ['POO', 'Cálculo integral', 'Bases de datos', 'Proyecto integrador I'] },
  { n: '04', title: 'Diseña', stage: 'build', subjects: ['Estructuras de datos', 'Aplicaciones web', 'Diseño de software', 'Apps móviles'] },
  { n: '05', title: 'Integra', stage: 'build', subjects: ['Bases de datos avanzadas', 'Servicios web', 'Estándares de software', 'Proyecto integrador II'] },
  { n: '06', title: 'Experimenta', stage: 'real', subjects: ['Estadía universitaria', 'Multiplataforma', 'Equipos de alto desempeño', 'Portafolio profesional'] },
  { n: '07', title: 'Innova', stage: 'real', subjects: ['Inteligencia artificial', 'Proyectos de tecnología', 'Seguridad informática', 'Optativa I'] },
  { n: '08', title: 'Lidera', stage: 'real', subjects: ['Programación para IA', 'Gestión de proyectos', 'Servidores', 'Informática forense'] },
  { n: '09', title: 'Transforma', stage: 'real', subjects: ['Ciencia de datos', 'Internet de las cosas', 'Tecnologías disruptivas', 'Proyecto integrador III'] },
  { n: '10', title: 'Despega', stage: 'real', subjects: ['Estadía de ingeniería', 'Innovación digital', 'Proyecto profesional', 'Tu siguiente gran reto'] }
];

const disciplines = [
  { index: '01', title: 'Código', copy: 'Interfaces, apps y productos digitales.', color: 'pink', symbol: '</>' },
  { index: '02', title: 'Datos', copy: 'IA para entender lo que otros no ven.', color: 'lime', symbol: '◉' },
  { index: '03', title: 'Conexión', copy: 'Redes, IoT y seguridad con propósito.', color: 'blue', symbol: '⌁' }
];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17152b" />
    <meta name="description" content="Rumbo TI: descubre la Ingeniería en Tecnologías de la Información e Innovación Digital en la UTOM." />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>Rumbo TI — UTOM</title>
  </head>
  <body>
    <header class="topbar">
      <a class="logo" href="#inicio"><Image src={logoUtom} alt="Universidad Tecnológica del Oriente de Michoacán" format="webp" loading="eager" fetchpriority="high" /></a>
      <nav aria-label="Navegación principal"><a href="#explora">Explora</a><a href="#mapa">Mapa curricular</a><a href="#participa">Participa</a><a href="#contacto">Contacto</a></nav>
      <a class="top-action" href="#mapa"><span>ver la ruta</span><b>↗</b></a>
    </header>

    <main>
      <section id="inicio" class="hero reference-hero">
        <div class="hero-loops" aria-hidden="true"><i></i><i></i><i></i></div>
        <svg class="hero-arc" viewBox="0 0 420 210" aria-hidden="true" focusable="false">
          <path d="M45 0C45 240 375 240 375 0" />
        </svg>
        <div class="reference-copy">
          <div class="reference-kicker"><i></i> UNIVERSIDAD TECNOLÓGICA DEL ORIENTE DE MICHOACÁN</div>
          <div class="reference-eyebrow">INGENIERÍA EN TECNOLOGÍAS DE LA INFORMACIÓN E INNOVACIÓN DIGITAL</div>
          <h1>CONECTA. <em>CREA.</em><br />IMPULSA.</h1>
          <p class="reference-lede">Tu talento puede convertirse en tecnología, proyectos y soluciones que hacen avanzar a tu comunidad.</p>
          <div class="reference-actions"><a class="button button-light" href="#explora">Descubre tu ruta <span>↗</span></a><a class="reference-link" href="#mapa">Ver mapa curricular <span>↓</span></a></div>
        </div>
        <div class="reference-stage">
          <div class="stage-index">SOMOS <b>LINCES</b></div>
          <div class="stage-band band-one"><span>INTELIGENCIA ARTIFICIAL</span><b>✦</b><span>DATOS + CÓDIGO</span></div>
          <div class="stage-band band-two"><span>REDES DIGITALES</span><b>✦</b><span>CREATIVIDAD</span></div>
          <Image class="reference-mascot reference-hero-student" src={studentHero} alt="Estudiante de la UTOM trabajando con una laptop" format="webp" loading="eager" fetchpriority="high" sizes="(max-width: 640px) 96vw, (max-width: 900px) 84vw, 1320px" />
          <div class="reference-sticker">TI / 2026 <span>✦</span></div>
        </div>
        <div class="reference-stats"><div><strong>40%</strong><span>formación teórica</span></div><div class="stat-main"><strong>60%</strong><span>aprendizaje práctico</span></div><div><strong>2</strong><span>títulos profesionales</span></div></div>
      </section>

      <div class="paper-strip" aria-label="La UTOM te prepara para el futuro"><span>APRENDE HACIENDO</span><b>✦</b><span>CREA SIN LÍMITES</span><b>✦</b><span>CONSTRUYE TU RUMBO</span></div>

      <section id="explora" class="explore section-shell">
        <div class="split-heading"><h2>ELIGE TU<br /><em>ÁREA DE JUEGO.</em></h2><p>Tu perfil no tiene que caber en una sola caja. Aquí mezclas código, datos y conexión para crear soluciones que sí importan.</p></div>
        <div class="discipline-grid">
          {disciplines.map((item) => <article class={`discipline-card ${item.color}`}><div class="discipline-meta"><span>{item.index}</span><span>↗</span></div><div class="discipline-symbol">{item.symbol}</div><h3>{item.title}</h3><p>{item.copy}</p></article>)}
        </div>
      </section>

      <section class="tech-lab section-shell">
        <h3 class="tech-grid-title">Herramientas para crear</h3>
        <div class="tech-lab-copy"><h2>DE LA IDEA<br />AL <em>PROYECTO.</em></h2><p>No se trata solo de aprender programas: usarás herramientas para diseñar, construir, conectar y compartir soluciones digitales.</p><div class="tech-project"><span>RETO DE INICIO</span><strong>Convierte necesidades en soluciones reales.</strong></div></div>
        <div class="tech-grid" aria-label="Tecnologías y áreas de aprendizaje"><article><b>&lt;/&gt;</b><span>WEB</span><p>HTML · CSS · JavaScript</p><div class="tech-logos"><img class="tech-logo tech-logo-image" src={htmlLogo.src} alt="HTML" width="32" height="32" loading="lazy" /><img class="tech-logo tech-logo-image" src={javascriptLogo.src} alt="JavaScript" width="32" height="32" loading="lazy" /><img class="tech-logo tech-logo-image" src={tailwindLogo.src} alt="Tailwind CSS" width="32" height="32" loading="lazy" /></div></article><article><b>PY</b><span>PROGRAMACIÓN</span><p>Python · lógica · IA</p><div class="tech-logos"><img class="tech-logo tech-logo-image" src={pythonLogo.src} alt="Python" width="32" height="32" loading="lazy" /><img class="tech-logo tech-logo-image" src={javaLogo.src} alt="Java" width="32" height="32" loading="lazy" /></div></article><article><b>SQL</b><span>DATOS</span><p>Bases de datos · análisis</p><div class="tech-logos"><img class="tech-logo tech-logo-image" src={postgresqlLogo.src} alt="PostgreSQL" width="32" height="32" loading="lazy" /><img class="tech-logo tech-logo-image tech-logo--mysql" src={mysqlLogo.src} alt="MySQL" width="32" height="32" loading="lazy" /></div></article><article><b>GIT</b><span>COLABORACIÓN</span><p>Versiones · equipos</p><div class="tech-logos tech-logos--git"><img class="tech-logo tech-logo-image" src={gitLogo.src} alt="Git" width="32" height="32" loading="lazy" /><img class="tech-logo tech-logo-image tech-logo--github" src={githubLogo.src} alt="GitHub" width="32" height="32" loading="lazy" /></div></article><article><b>AI</b><span>INTELIGENCIA</span><p>Modelos · creatividad</p><div class="tech-logos"><img class="tech-logo tech-logo-image" src={pythonLogo.src} alt="Python" width="32" height="32" loading="lazy" /><img class="tech-logo tech-logo-image" src={numpyLogo.src} alt="NumPy" width="32" height="32" loading="lazy" /><img class="tech-logo tech-logo-image" src={pandasLogo.src} alt="Pandas" width="32" height="32" loading="lazy" /></div></article><article><b>NET</b><span>CONEXIÓN</span><p>Redes · seguridad · IoT</p><div class="tech-logos"><img class="tech-logo tech-logo-image" src={arduinoLogo.src} alt="Arduino" width="32" height="32" loading="lazy" /><img class="tech-logo tech-logo-image" src={raspberryPiLogo.src} alt="Raspberry Pi" width="32" height="32" loading="lazy" /><img class="tech-logo tech-logo-image" src={ciscoLogo.src} alt="Cisco" width="32" height="32" loading="lazy" /></div></article></div>
      </section>

      <section id="mapa" class="map-section section-shell">
        <div class="section-tag light-tag">mapa de evolución</div>
        <div class="map-heading"><h2>Tu ruta,<br /><em>en movimiento.</em></h2><div><p>Diez cuatrimestres. Una progresión real: de tus primeros algoritmos hasta proyectos que pueden llegar a una empresa.</p><div class="map-legend"><span><i class="dot dot-base"></i>base</span><span><i class="dot dot-build"></i>construcción</span><span><i class="dot dot-real"></i>mundo real</span></div></div></div>
        <div class="semester-track">
          {semesters.map((semester) => <article class={`semester ${semester.stage}`}><div class="semester-head"><b>{semester.n}</b><span>{semester.title}</span></div><ul>{semester.subjects.map((subject) => <li>{subject}</li>)}</ul><span class="semester-corner">↗</span></article>)}
        </div>
        <div class="track-footer"><span>sigue la ruta</span><i></i><span>10 etapas / 1 gran salto</span></div>
      </section>

      <section id="participa" class="participa section-shell">
        <div class="participa-intro"><div class="section-tag">vive la experiencia</div><h2>No vienes solo<br />a <em>estudiar.</em></h2><p>En TI conviertes ideas en soluciones junto a otras personas: colaboras, presentas lo que construyes y aprendes de retos reales.</p></div>
        <div class="participa-grid">
          <article><span>01</span><h3>Colabora</h3><p>Forma equipos, comparte ideas y crea proyectos que tengan impacto.</p><b>↗</b></article>
          <article><span>02</span><h3>Construye</h3><p>Lleva tus conocimientos de clase a prototipos, apps y experiencias digitales.</p><b>↗</b></article>
          <article><span>03</span><h3>Presenta</h3><p>Haz visible tu talento con portafolios y proyectos integradores.</p><b>↗</b></article>
        </div>
      </section>

      <section id="contacto" class="final-cta"><div class="final-student"><Image src={studentCta} alt="Estudiante de la UTOM listo para iniciar su camino profesional" format="webp" loading="lazy" sizes="(max-width: 640px) 78vw, 520px" /></div><div><div class="micro-label">¿LISTO PARA EMPEZAR?</div><h2>Haz espacio<br />para tu <em>futuro.</em></h2><a class="button button-dark" href="#mapa">Explora el mapa <span>↓</span></a></div></section>
    </main>

    <footer><Image class="footer-logo-image" style="width:190px;height:auto;display:block" src={logoUtom} alt="Universidad Tecnológica del Oriente de Michoacán" format="webp" /><span>Universidad Tecnológica del Oriente de Michoacán</span><span>servicios_escolares@utom.edu.mx · +52 447 150 8913</span></footer>
    <script>
      if ('serviceWorker' in navigator) window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
    </script>
  </body>
</html>
